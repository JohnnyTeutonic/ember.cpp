{
  "_comment": "paperkiln IR v0 for fw_moe, exported by mtstudio. Schema and semantics: microtorch/ir.hpp and LOCAL_LLM_STACK.md section 4.",
  "ir_version": 0,
  "family_hint": "llama",
  "model": {
    "vocab": 8192,
    "d": 384,
    "n_layers": 6,
    "ctx": 256,
    "dtype": "f32"
  },
  "tokenizer": {
    "type": "bpe",
    "source": "gguf",
    "specials": {
      "unk": 0,
      "eot": 1,
      "user": 2,
      "assistant": 3
    },
    "bos": null
  },
  "inputs": [
    {
      "name": "tokens",
      "kind": "token_ids"
    },
    {
      "name": "pos",
      "kind": "positions",
      "note": "absolute positions; prefill 0..T-1, decode = cache length"
    }
  ],
  "embed": {
    "nodes": [
      {
        "op": "embedding",
        "in": [
          "tokens"
        ],
        "weight": "token_embd.weight",
        "out": "x"
      }
    ]
  },
  "block": {
    "repeat": 6,
    "state": [
      {
        "name": "kv",
        "kind": "kv",
        "heads": 6,
        "kv_heads": 6,
        "head_dim": 64,
        "max_len": 256,
        "window": 0,
        "sinks": 0,
        "dtype": "f32"
      }
    ],
    "nodes": [
      {
        "op": "rmsnorm",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.attn_norm.weight",
        "eps": 1e-05,
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "blk.{i}.attn_q.weight",
        "bias": null,
        "out": "q"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "blk.{i}.attn_k.weight",
        "bias": null,
        "out": "k"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "blk.{i}.attn_v.weight",
        "bias": null,
        "out": "v"
      },
      {
        "op": "rope",
        "in": [
          "q",
          "k",
          "pos"
        ],
        "heads": 6,
        "head_dim": 64,
        "theta": 10000.0,
        "rope_heads": "all",
        "pairing": "interleaved",
        "_note": "adjacent pairs (x[2j], x[2j+1]) within each head, angle pos * theta^(-2j/head_dim); products rounded separately (no FMA)",
        "out": [
          "q",
          "k"
        ]
      },
      {
        "op": "attention",
        "in": [
          "q",
          "k",
          "v"
        ],
        "state": "kv",
        "heads": 6,
        "kv_heads": 6,
        "head_dim": 64,
        "causal": true,
        "scale": 0.125,
        "window": 0,
        "sinks": 0,
        "softmax": "max-shifted, masked entries exactly zero",
        "out": "a"
      },
      {
        "op": "linear",
        "in": [
          "a"
        ],
        "weight": "blk.{i}.attn_output.weight",
        "bias": null,
        "out": "o"
      },
      {
        "op": "add",
        "in": [
          "x",
          "o"
        ],
        "out": "x"
      },
      {
        "op": "rmsnorm",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.ffn_norm.weight",
        "eps": 1e-05,
        "out": "h2"
      },
      {
        "op": "moe_ffn",
        "in": [
          "h2"
        ],
        "router": "blk.{i}.ffn_gate_inp.weight",
        "experts": {
          "gate": "blk.{i}.ffn_gate_exps.weight",
          "up": "blk.{i}.ffn_up_exps.weight",
          "down": "blk.{i}.ffn_down_exps.weight"
        },
        "n_experts": 8,
        "top_k": 2,
        "gate_norm": "renorm",
        "activation": "silu",
        "routing": "softmax over E logits, top-k (ties to the lower index), renormalise the k probabilities, sum of gate * SwiGLU_e(x)",
        "_note": "paperkiln computes the renormalised gates as a softmax over the k selected logits (the same quantity) and accumulates the expert outputs in ascending expert index",
        "out": "f"
      },
      {
        "op": "add",
        "in": [
          "x",
          "f"
        ],
        "out": "x"
      }
    ]
  },
  "head": {
    "nodes": [
      {
        "op": "rmsnorm",
        "in": [
          "x"
        ],
        "weight": "output_norm.weight",
        "eps": 1e-05,
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "output.weight",
        "bias": null,
        "tied_to": "token_embd.weight",
        "out": "logits"
      }
    ]
  },
  "outputs": [
    {
      "name": "logits",
      "kind": "logits"
    }
  ],
  "modes": {
    "prefill": "all nodes over T tokens",
    "decode": "the same graph with T = 1, attention reads and appends to the kv state"
  }
}
