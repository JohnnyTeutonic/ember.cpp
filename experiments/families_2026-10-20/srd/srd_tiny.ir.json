{
  "_comment": "paperkiln IR v0 for srd_tiny, exported by mtstudio. Schema and semantics: microtorch/ir.hpp and LOCAL_LLM_STACK.md section 4.",
  "ir_version": 0,
  "family_hint": "srd",
  "model": {
    "vocab": 8192,
    "d": 128,
    "n_layers": 2,
    "ctx": 128,
    "dtype": "f32"
  },
  "tokenizer": {
    "type": "bpe",
    "source": "gguf",
    "specials": {
      "unk": 0,
      "eot": 1,
      "user": 2,
      "assistant": 3
    },
    "bos": null
  },
  "inputs": [
    {
      "name": "tokens",
      "kind": "token_ids"
    },
    {
      "name": "pos",
      "kind": "positions",
      "note": "absolute positions; prefill 0..T-1, decode = tokens seen so far; must stay below model.ctx"
    }
  ],
  "embed": {
    "nodes": [
      {
        "op": "embedding",
        "in": [
          "tokens"
        ],
        "weight": "token_embd.weight",
        "out": "x"
      },
      {
        "op": "pos_embedding",
        "in": [
          "x",
          "pos"
        ],
        "weight": "position_embd.weight",
        "out": "x"
      }
    ]
  },
  "block": {
    "repeat": 2,
    "state": [
      {
        "name": "kv",
        "kind": "kv",
        "heads": 2,
        "kv_heads": 2,
        "head_dim": 64,
        "max_len": 128,
        "window": 0,
        "sinks": 0,
        "dtype": "f32"
      },
      {
        "name": "lin",
        "kind": "recurrent",
        "op": "linear_attention",
        "dtype": "f32",
        "tensors": [
          {
            "name": "num",
            "shape": [
              2,
              64
            ],
            "init": 0
          },
          {
            "name": "den",
            "shape": [
              2,
              64
            ],
            "init": 0
          }
        ]
      }
    ],
    "nodes": [
      {
        "op": "layernorm",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.attn_norm.weight",
        "bias": "blk.{i}.attn_norm.bias",
        "eps": 1e-05,
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "blk.{i}.srd_pred_up.weight",
        "bias": "blk.{i}.srd_pred_up.bias",
        "out": "p"
      },
      {
        "op": "gelu",
        "in": [
          "p"
        ],
        "approx": "tanh",
        "out": "p"
      },
      {
        "op": "linear",
        "in": [
          "p"
        ],
        "weight": "blk.{i}.srd_pred_down.weight",
        "bias": "blk.{i}.srd_pred_down.bias",
        "out": "p"
      },
      {
        "op": "sub",
        "in": [
          "h",
          "p"
        ],
        "out": "p"
      },
      {
        "op": "rms_row",
        "in": [
          "p"
        ],
        "eps": 1e-08,
        "out": "g"
      },
      {
        "op": "affine",
        "in": [
          "g"
        ],
        "scale": 4.0,
        "shift": -1.0,
        "out": "g"
      },
      {
        "op": "sigmoid",
        "in": [
          "g"
        ],
        "out": "g"
      },
      {
        "op": "affine",
        "in": [
          "g"
        ],
        "scale": -1.0,
        "shift": 1.0,
        "out": "gi"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "blk.{i}.attn_qkv.weight",
        "bias": "blk.{i}.attn_qkv.bias",
        "out": "qkv"
      },
      {
        "op": "split",
        "in": [
          "qkv"
        ],
        "sizes": [
          128,
          128,
          128
        ],
        "out": [
          "q",
          "k",
          "v"
        ]
      },
      {
        "op": "attention",
        "in": [
          "q",
          "k",
          "v"
        ],
        "state": "kv",
        "heads": 2,
        "kv_heads": 2,
        "head_dim": 64,
        "causal": true,
        "scale": 0.125,
        "window": 0,
        "sinks": 0,
        "softmax": "max-shifted, masked entries exactly zero",
        "out": "a"
      },
      {
        "op": "linear_attention",
        "in": [
          "q",
          "k",
          "v"
        ],
        "state": "lin",
        "heads": 2,
        "head_dim": 64,
        "causal": true,
        "feature_map": "elu_plus_one",
        "den_floor": 1e-08,
        "out": "l"
      },
      {
        "op": "mul_col",
        "in": [
          "a",
          "g"
        ],
        "out": "a"
      },
      {
        "op": "mul_col",
        "in": [
          "l",
          "gi"
        ],
        "out": "l"
      },
      {
        "op": "add",
        "in": [
          "a",
          "l"
        ],
        "out": "a"
      },
      {
        "op": "linear",
        "in": [
          "a"
        ],
        "weight": "blk.{i}.attn_output.weight",
        "bias": "blk.{i}.attn_output.bias",
        "out": "o"
      },
      {
        "op": "add",
        "in": [
          "x",
          "o"
        ],
        "out": "x"
      },
      {
        "op": "layernorm",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.ffn_norm.weight",
        "bias": "blk.{i}.ffn_norm.bias",
        "eps": 1e-05,
        "out": "h2"
      },
      {
        "op": "linear",
        "in": [
          "h2"
        ],
        "weight": "blk.{i}.ffn_up.weight",
        "bias": "blk.{i}.ffn_up.bias",
        "out": "u"
      },
      {
        "op": "gelu",
        "in": [
          "u"
        ],
        "approx": "tanh",
        "out": "u"
      },
      {
        "op": "linear",
        "in": [
          "u"
        ],
        "weight": "blk.{i}.ffn_down.weight",
        "bias": "blk.{i}.ffn_down.bias",
        "out": "f"
      },
      {
        "op": "add",
        "in": [
          "x",
          "f"
        ],
        "out": "x"
      }
    ]
  },
  "head": {
    "nodes": [
      {
        "op": "layernorm",
        "in": [
          "x"
        ],
        "weight": "output_norm.weight",
        "bias": "output_norm.bias",
        "eps": 1e-05,
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "output.weight",
        "bias": null,
        "out": "logits"
      }
    ]
  },
  "outputs": [
    {
      "name": "logits",
      "kind": "logits"
    }
  ],
  "modes": {
    "prefill": "all nodes over T tokens; each recurrent op scans t = 0..T-1 in order",
    "decode": "the same graph with T = 1; attention reads and appends to its kv state; each recurrent op applies one update to its recurrent state"
  }
}
