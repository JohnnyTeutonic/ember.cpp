{
  "_comment": "paperkiln IR v0 for flex_highway_tiny, exported by mtstudio. Schema and semantics: microtorch/ir.hpp and LOCAL_LLM_STACK.md section 4.",
  "ir_version": 0,
  "family_hint": "flex_highway",
  "model": {
    "vocab": 8192,
    "d": 128,
    "n_layers": 2,
    "ctx": 128,
    "dtype": "f32"
  },
  "tokenizer": {
    "type": "bpe",
    "source": "gguf",
    "specials": {
      "unk": 0,
      "eot": 1,
      "user": 2,
      "assistant": 3
    },
    "bos": null
  },
  "inputs": [
    {
      "name": "tokens",
      "kind": "token_ids"
    },
    {
      "name": "pos",
      "kind": "positions",
      "note": "absolute positions; prefill 0..T-1, decode = tokens seen so far; must stay below model.ctx"
    }
  ],
  "embed": {
    "nodes": [
      {
        "op": "embedding",
        "in": [
          "tokens"
        ],
        "weight": "token_embd.weight",
        "out": "x"
      },
      {
        "op": "pos_embedding",
        "in": [
          "x",
          "pos"
        ],
        "weight": "position_embd.weight",
        "out": "x"
      }
    ]
  },
  "block": {
    "repeat": 2,
    "state": [
      {
        "name": "kv",
        "kind": "kv",
        "heads": 2,
        "kv_heads": 2,
        "head_dim": 64,
        "max_len": 128,
        "window": 0,
        "sinks": 0,
        "dtype": "f32"
      }
    ],
    "nodes": [
      {
        "op": "rmsnorm",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.attn_norm.weight",
        "eps": 1e-05,
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "blk.{i}.attn_qkv.weight",
        "bias": "blk.{i}.attn_qkv.bias",
        "out": "qkv"
      },
      {
        "op": "split",
        "in": [
          "qkv"
        ],
        "sizes": [
          128,
          128,
          128
        ],
        "out": [
          "q",
          "k",
          "v"
        ]
      },
      {
        "op": "attention",
        "in": [
          "q",
          "k",
          "v"
        ],
        "state": "kv",
        "heads": 2,
        "kv_heads": 2,
        "head_dim": 64,
        "causal": true,
        "scale": 0.125,
        "window": 0,
        "sinks": 0,
        "softmax": "max-shifted, masked entries exactly zero",
        "out": "a"
      },
      {
        "op": "linear",
        "in": [
          "a"
        ],
        "weight": "blk.{i}.attn_output.weight",
        "bias": "blk.{i}.attn_output.bias",
        "out": "o"
      },
      {
        "op": "linear",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.highway_attn.weight",
        "bias": "blk.{i}.highway_attn.bias",
        "out": "t"
      },
      {
        "op": "sigmoid",
        "in": [
          "t"
        ],
        "out": "t"
      },
      {
        "op": "sub",
        "in": [
          "o",
          "x"
        ],
        "out": "o"
      },
      {
        "op": "mul",
        "in": [
          "t",
          "o"
        ],
        "out": "o"
      },
      {
        "op": "add",
        "in": [
          "x",
          "o"
        ],
        "out": "x"
      },
      {
        "op": "rmsnorm",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.ffn_norm.weight",
        "eps": 1e-05,
        "out": "h2"
      },
      {
        "op": "linear",
        "in": [
          "h2"
        ],
        "weight": "blk.{i}.ffn_gate.weight",
        "bias": null,
        "out": "g"
      },
      {
        "op": "silu",
        "in": [
          "g"
        ],
        "out": "g"
      },
      {
        "op": "linear",
        "in": [
          "h2"
        ],
        "weight": "blk.{i}.ffn_up.weight",
        "bias": null,
        "out": "u"
      },
      {
        "op": "mul",
        "in": [
          "g",
          "u"
        ],
        "out": "g"
      },
      {
        "op": "linear",
        "in": [
          "g"
        ],
        "weight": "blk.{i}.ffn_down.weight",
        "bias": null,
        "out": "f"
      },
      {
        "op": "linear",
        "in": [
          "x"
        ],
        "weight": "blk.{i}.highway_ffn.weight",
        "bias": "blk.{i}.highway_ffn.bias",
        "out": "t"
      },
      {
        "op": "sigmoid",
        "in": [
          "t"
        ],
        "out": "t"
      },
      {
        "op": "sub",
        "in": [
          "f",
          "x"
        ],
        "out": "f"
      },
      {
        "op": "mul",
        "in": [
          "t",
          "f"
        ],
        "out": "f"
      },
      {
        "op": "add",
        "in": [
          "x",
          "f"
        ],
        "out": "x"
      }
    ]
  },
  "head": {
    "nodes": [
      {
        "op": "rmsnorm",
        "in": [
          "x"
        ],
        "weight": "output_norm.weight",
        "eps": 1e-05,
        "out": "h"
      },
      {
        "op": "linear",
        "in": [
          "h"
        ],
        "weight": "output.weight",
        "bias": null,
        "out": "logits"
      }
    ]
  },
  "outputs": [
    {
      "name": "logits",
      "kind": "logits"
    }
  ],
  "modes": {
    "prefill": "all nodes over T tokens",
    "decode": "the same graph with T = 1; attention reads and appends to its kv state"
  }
}
