{
 "_comment": "kimi_tiny with its linear attention replaced by a recurrence of the WebGPU recurrence gate (ember experiments/webgpu_recurrence_2026-10-27/make_docs.py); not a trained model",
 "ir_version": 0,
 "family_hint": "kimi_recurrence",
 "model": {
  "vocab": 8192,
  "d": 128,
  "n_layers": 2,
  "ctx": 128,
  "dtype": "f32"
 },
 "tokenizer": {
  "type": "bpe",
  "source": "gguf",
  "specials": {
   "unk": 0,
   "eot": 1,
   "user": 2,
   "assistant": 3
  },
  "bos": null
 },
 "inputs": [
  {
   "name": "tokens",
   "kind": "token_ids"
  },
  {
   "name": "pos",
   "kind": "positions",
   "note": "absolute positions; prefill 0..T-1, decode = tokens seen so far; must stay below model.ctx"
  }
 ],
 "embed": {
  "nodes": [
   {
    "op": "embedding",
    "in": [
     "tokens"
    ],
    "weight": "token_embd.weight",
    "out": "x"
   },
   {
    "op": "pos_embedding",
    "in": [
     "x",
     "pos"
    ],
    "weight": "position_embd.weight",
    "out": "x"
   }
  ]
 },
 "block": {
  "repeat": 2,
  "state": [
   {
    "name": "lin",
    "kind": "recurrent",
    "op": "recurrence",
    "dtype": "f32",
    "tensors": [
     {
      "name": "num",
      "shape": [
       2,
       64
      ],
      "init": "body"
     },
     {
      "name": "den",
      "shape": [
       2,
       64
      ],
      "init": "body"
     },
     {
      "name": "c",
      "shape": [
       2
      ],
      "init": 0
     }
    ]
   }
  ],
  "nodes": [
   {
    "op": "layernorm",
    "in": [
     "x"
    ],
    "weight": "blk.{i}.attn_norm.weight",
    "bias": "blk.{i}.attn_norm.bias",
    "eps": 1e-05,
    "out": "h"
   },
   {
    "op": "linear",
    "in": [
     "h"
    ],
    "weight": "blk.{i}.attn_qkv.weight",
    "bias": "blk.{i}.attn_qkv.bias",
    "out": "qkv"
   },
   {
    "op": "split",
    "in": [
     "qkv"
    ],
    "sizes": [
     128,
     128,
     128
    ],
    "out": [
     "q",
     "k",
     "v"
    ]
   },
   {
    "op": "recurrence",
    "in": [
     "q",
     "k",
     "v"
    ],
    "state": "lin",
    "out": "a",
    "index": {
     "h": 2,
     "e": 64,
     "f": 64
    },
    "inputs": [
     "q[h,e]",
     "k[h,e]",
     "v[h,e]"
    ],
    "weights": {
     "h0[h,e]": "blk.{i}.attn_norm.bias",
     "g[h,e]": "blk.{i}.attn_norm.weight"
    },
    "init": [
     "num[h,e] = 0.1 * h0[h,e]",
     "den[h,e] = 1 + abs(h0[h,e])"
    ],
    "let": [
     "pk[h,e] = where(k[h,e], k[h,e] + 1, exp(min(0, k[h,e]))) + 0.25 * relu(k[h,e - 1])",
     "a[h,e] = 0.5 + 0.5 * sigmoid(g[h,e])"
    ],
    "update": [
     "num[h,e] = a[h,e] * num[h,e] + pk[h,e] * v[h,e]",
     "den[h,e] = a[h,e] * den[h,e] + pk[h,e]",
     "c[h] = 0.9 * c[h] + sum(f, pk[h,f] * q[h,f]) / 64"
    ],
    "readout": "y[h,e] = (where(q[h,e], q[h,e] + 1, exp(min(0, q[h,e]))) * num[h,e]) / max(den[h,e], 0.000001) + 0.01 * tanh(c[h]) + 0.001 * e"
   },
   {
    "op": "linear",
    "in": [
     "a"
    ],
    "weight": "blk.{i}.attn_output.weight",
    "bias": "blk.{i}.attn_output.bias",
    "out": "o"
   },
   {
    "op": "add",
    "in": [
     "x",
     "o"
    ],
    "out": "x"
   },
   {
    "op": "layernorm",
    "in": [
     "x"
    ],
    "weight": "blk.{i}.ffn_norm.weight",
    "bias": "blk.{i}.ffn_norm.bias",
    "eps": 1e-05,
    "out": "h2"
   },
   {
    "op": "linear",
    "in": [
     "h2"
    ],
    "weight": "blk.{i}.ffn_up.weight",
    "bias": "blk.{i}.ffn_up.bias",
    "out": "u"
   },
   {
    "op": "gelu",
    "in": [
     "u"
    ],
    "approx": "tanh",
    "out": "u"
   },
   {
    "op": "linear",
    "in": [
     "u"
    ],
    "weight": "blk.{i}.ffn_down.weight",
    "bias": "blk.{i}.ffn_down.bias",
    "out": "f"
   },
   {
    "op": "add",
    "in": [
     "x",
     "f"
    ],
    "out": "x"
   }
  ]
 },
 "head": {
  "nodes": [
   {
    "op": "layernorm",
    "in": [
     "x"
    ],
    "weight": "output_norm.weight",
    "bias": "output_norm.bias",
    "eps": 1e-05,
    "out": "h"
   },
   {
    "op": "linear",
    "in": [
     "h"
    ],
    "weight": "output.weight",
    "bias": null,
    "out": "logits"
   }
  ]
 },
 "outputs": [
  {
   "name": "logits",
   "kind": "logits"
  }
 ],
 "modes": {
  "prefill": "all nodes over T tokens; each recurrent op scans t = 0..T-1 in order",
  "decode": "the same graph with T = 1; each recurrent op applies one update to its recurrent state"
 }
}