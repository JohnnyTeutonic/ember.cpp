{
 "_comment": "built by ember's build_ir_from_gguf (graph_ir.cpp; paperkiln tools/gguf_ir.py's rules) from general.architecture = mamba and its metadata",
 "block": {
  "nodes": [
   {
    "eps": 1e-05,
    "in": [
     "x"
    ],
    "op": "rmsnorm",
    "out": "h",
    "weight": "blk.{i}.attn_norm.weight"
   },
   {
    "bias": null,
    "in": [
