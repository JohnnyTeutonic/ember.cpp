    ],
    "op": "linear",
    "out": "xz",
    "weight": "blk.{i}.ssm_in.weight"
   },
   {
    "in": [
     "xz"
    ],
    "op": "split",
    "out": [
     "xs",
     "z"
    ],
    "sizes": [
     1536,
     1536
    ]
   },
   {
    "op": "recurrence",
    "in": [
     "xs"
    ],
    "state": "conv",
    "index": {
     "c": 1536,
     "k": 4,
     "r": 3
    },
    "inputs": [
     "u[c]"
    ],
    "weights": {
     "W[c,k]": "blk.{i}.ssm_conv1d.weight",
     "Bias[c]": "blk.{i}.ssm_conv1d.bias"
    },
    "let": [
     "xx[k,c] = where(k - 2.5, u[c], x[k,c])"
    ],
    "update": [
     "x[r,c] = xx[r + 1,c]"
    ],
    "readout": "y[c] = sum(k, W[c,k] * xx[k,c]) + Bias[c]",
    "out": "xs"
   },
   {
    "in": [
     "xs"
    ],
    "op": "silu",
    "out": "xs"
   },
   {
    "bias": null,
    "in": [
     "xs"
    ],
    "op": "linear",
    "out": "xdb",
    "weight": "blk.{i}.ssm_x.weight"
   },
   {
    "in": [
     "xdb"
    ],
    "op": "split",
    "out": [
     "dt",
     "bm",
     "cm"
    ],
    "sizes": [
     48,
     16,
     16
    ]
   },
   {
    "bias": "blk.{i}.ssm_dt.bias",
    "in": [
     "dt"
    ],
    "op": "linear",
    "out": "dt",
    "weight": "blk.{i}.ssm_dt.weight"
   },
   {
    "op": "recurrence",
    "in": [
     "xs",
     "dt",
     "bm",
     "cm"
    ],
    "state": "ssm",
    "index": {
     "c": 1536,
     "n": 16
    },
    "inputs": [
     "x[c]",
     "dt[c]",
     "Bm[n]",
     "Cm[n]"
    ],
    "weights": {
     "A[c,n]": "blk.{i}.ssm_a",
     "Dk[c]": "blk.{i}.ssm_d"
    },
    "let": [
     "delta[c] = where(dt[c] - 20, dt[c], log(1 + exp(min(20, dt[c]))))",
     "xd[c] = x[c] * delta[c]"
    ],
    "update": [
     "s[c,n] = s[c,n] * exp(delta[c] * A[c,n]) + Bm[n] * xd[c]"
    ],
    "readout": "y[c] = sum(n, s[c,n] * Cm[n]) + Dk[c] * x[c]",
    "out": "y"
   },
   {
    "in": [
     "z"
    ],
    "op": "silu",
    "out": "z"
   },
   {
    "in": [
     "y",
     "z"
    ],
    "op": "mul",
    "out": "y"
   },
