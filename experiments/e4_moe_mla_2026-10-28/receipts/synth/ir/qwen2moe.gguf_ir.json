{
 "_comment": "built by tools/gguf_ir.py from general.architecture = qwen2moe and its metadata",
 "ir_version": 1,
 "family_hint": "qwen2moe",
 "model": {
  "vocab": 512,
  "d": 64,
  "n_layers": 3,
  "ctx": 256,
  "dtype": "f32"
 },
 "tokenizer": {
  "type": "gguf",
  "source": "gguf",
  "specials": {},
  "bos": null
 },
 "inputs": [
  {
   "name": "tokens",
   "kind": "token_ids"
  },
  {
   "name": "pos",
   "kind": "positions"
  }
 ],
 "embed": {
  "nodes": [
   {
    "op": "embedding",
    "in": [
     "tokens"
    ],
    "weight": "token_embd.weight",
    "out": "x"
   }
  ]
 },
 "block": {
  "repeat": 3,
  "state": [
   {
    "name": "kv",
    "kind": "kv",
    "heads": 4,
    "kv_heads": 2,
    "head_dim": 16,
    "max_len": 256,
    "window": 0,
    "sinks": 0,
    "dtype": "f32"
   }
  ],
  "nodes": [
   {
    "op": "rmsnorm",
    "in": [
     "x"
    ],
    "weight": "blk.{i}.attn_norm.weight",
    "eps": 1e-06,
    "out": "h"
   },
   {
    "op": "linear",
    "in": [
     "h"
    ],
    "weight": "blk.{i}.attn_q.weight",
    "bias": "blk.{i}.attn_q.bias",
    "out": "q"
   },
   {
    "op": "linear",
    "in": [
     "h"
    ],
    "weight": "blk.{i}.attn_k.weight",
    "bias": "blk.{i}.attn_k.bias",
    "out": "k"
   },
   {
    "op": "linear",
    "in": [
     "h"
    ],
    "weight": "blk.{i}.attn_v.weight",
    "bias": "blk.{i}.attn_v.bias",
    "out": "v"
   },
   {
    "op": "rope",
    "in": [
     "q",
     "k",
     "pos"
    ],
    "heads": 4,
    "kv_heads": 2,
    "head_dim": 16,
    "n_rot": 16,
    "theta": 1000000.0,
    "rope_heads": "all",
    "pairing": "neox",
    "out": [
     "q",
     "k"
    ]
   },
   {
    "op": "attention",
    "in": [
     "q",
     "k",
     "v"
    ],
    "state": "kv",
    "heads": 4,
    "kv_heads": 2,
    "head_dim": 16,
    "causal": true,
    "scale": 0.25,
    "window": 0,
    "sinks": 0,
    "softmax": "max-shifted, masked entries exactly zero",
    "out": "a"
   },
   {
    "op": "linear",
    "in": [
     "a"
    ],
    "weight": "blk.{i}.attn_output.weight",
    "bias": null,
    "out": "o"
   },
   {
    "op": "add",
    "in": [
     "x",
     "o"
    ],
    "out": "x"
   },
   {
    "op": "rmsnorm",
    "in": [
     "x"
    ],
    "weight": "blk.{i}.ffn_norm.weight",
    "eps": 1e-06,
    "out": "h2"
   },
   {
    "op": "moe_ffn",
    "in": [
     "h2"
    ],
    "router": "blk.{i}.ffn_gate_inp.weight",
    "experts": {
     "gate": "blk.{i}.ffn_gate_exps.weight",
     "up": "blk.{i}.ffn_up_exps.weight",
     "down": "blk.{i}.ffn_down_exps.weight"
    },
    "n_experts": 6,
    "top_k": 2,
    "gate_norm": "raw",
    "activation": "silu",
    "out": "f"
   },
   {
    "op": "linear",
    "in": [
     "h2"
    ],
    "weight": "blk.{i}.ffn_gate_shexp.weight",
    "bias": null,
    "out": "sg"
   },
   {
    "op": "linear",
    "in": [
     "h2"
    ],
    "weight": "blk.{i}.ffn_up_shexp.weight",
    "bias": null,
    "out": "su"
   },
   {
    "op": "silu",
    "in": [
     "sg"
    ],
    "out": "sg"
   },
   {
    "op": "mul",
    "in": [
     "sg",
     "su"
    ],
    "out": "sgu"
   },
   {
    "op": "linear",
    "in": [
     "sgu"
    ],
    "weight": "blk.{i}.ffn_down_shexp.weight",
    "bias": null,
    "out": "sf"
   },
   {
    "op": "linear",
    "in": [
     "h2"
    ],
    "weight": "blk.{i}.ffn_gate_inp_shexp.weight",
    "bias": null,
    "out": "sgate"
   },
   {
    "op": "sigmoid",
    "in": [
     "sgate"
    ],
    "out": "sgate"
   },
   {
    "op": "mul_col",
    "in": [
     "sf",
     "sgate"
    ],
    "out": "sf"
   },
   {
    "op": "add",
    "in": [
     "f",
     "sf"
    ],
    "out": "f"
   },
   {
    "op": "add",
    "in": [
     "x",
     "f"
    ],
    "out": "x"
   }
  ]
 },
 "head": {
  "nodes": [
   {
    "op": "rmsnorm",
    "in": [
     "x"
    ],
    "weight": "output_norm.weight",
    "eps": 1e-06,
    "out": "h"
   },
   {
    "op": "linear",
    "in": [
     "h"
    ],
    "weight": "output.weight",
    "bias": null,
    "out": "logits"
   }
  ]
 },
 "outputs": [
  {
   "name": "logits",
   "kind": "logits"
  }
 ],
 "modes": {
  "prefill": "all nodes over T tokens",
  "decode": "the same graph with T = 1, attention reads and appends to the kv state, a recurrent op reads and replaces its recurrent state"
 }
}