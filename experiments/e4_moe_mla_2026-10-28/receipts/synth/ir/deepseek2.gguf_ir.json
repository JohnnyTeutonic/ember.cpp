    "out": "o"
   },
   {
    "op": "add",
    "in": [
     "x",
     "o"
    ],
    "out": "x"
   },
   {
    "op": "rmsnorm",
    "in": [
     "x"
    ],
    "weight": "blk.{i}.ffn_norm.weight",
