    "out": "q"
   },
   {
    "op": "split",
    "in": [
     "q"
    ],
    "sizes": [
     16,
     8
    ],
    "groups": 4,
    "out": [
     "qn",
     "qr"
    ]
   },
   {
    "op": "linear",
    "in": [
     "h"
    ],
    "weight": "blk.{i}.attn_kv_a_mqa.weight",
    "bias": null,
    "out": "ckr"
   },
   {
    "op": "split",
    "in": [
     "ckr"
    ],
    "sizes": [
     20,
     8
    ],
    "out": [
     "c",
     "kr"
    ]
   },
   {
    "op": "rmsnorm",
    "in": [
     "c"
    ],
    "weight": "blk.{i}.attn_kv_a_norm.weight",
    "eps": 1e-06,
    "out": "c"
   },
   {
    "op": "rope",
    "in": [
     "qr",
     "kr",
     "pos"
    ],
    "heads": 4,
    "kv_heads": 1,
    "head_dim": 8,
    "n_rot": 8,
    "theta": 10000.0,
    "rope_heads": "all",
    "pairing": "interleaved",
    "out": [
     "qr",
     "kr"
    ]
   },
   {
    "op": "mla_attention",
    "in": [
     "qn",
     "qr",
     "c",
     "kr"
    ],
    "state": "kv",
    "heads": 4,
    "kv_rank": 20,
    "qk_nope": 16,
    "qk_rope": 8,
    "v_head_dim": 12,
    "k_b": "blk.{i}.attn_k_b.weight",
    "v_b": "blk.{i}.attn_v_b.weight",
    "scale": 0.20412415,
    "causal": true,
    "window": 0,
    "sinks": 0,
    "out": "a"
   },
   {
    "op": "linear",
    "in": [
     "a"
    ],
    "weight": "blk.{i}.attn_output.weight",
