{"_comment":"paperkiln IR v1 for pk_recurrence, exported by mtstudio. Schema and semantics: microtorch/spec/IR_SPEC.md (schema spec/ir.schema.json).","ir_version":1,"family_hint":"recurrence","model":{"vocab":15,"d":16,"n_layers":2,"ctx":16,"dtype":"f32"},"tokenizer":{"type":"word","source":"gguf","specials":{"unk":0},"bos":null},"inputs":[{"name":"tokens","kind":"token_ids"},{"name":"pos","kind":"positions","note":"absolute positions; prefill 0..T-1, decode = tokens seen so far; must stay below model.ctx"}],"embed":{"nodes":[{"op":"embedding","in":["tokens"],"weight":"token_embd.weight","out":"x"},{"op":"pos_embedding","in":["x","pos"],"weight":"position_embd.weight","out":"x"}]},"block":{"repeat":2,"state":[{"name":"rec","kind":"recurrent","op":"recurrence","dtype":"f32","tensors":[{"name":"num","shape":[2,8],"init":0},{"name":"den","shape":[2,8],"init":0}]}],"nodes":[{"op":"layernorm","in":["x"],"weight":"blk.{i}.attn_norm.weight","bias":"blk.{i}.attn_norm.bias","eps":1e-05,"out":"h"},{"op":"linear","in":["h"],"weight":"blk.{i}.attn_qkv.weight","bias":"blk.{i}.attn_qkv.bias","out":"qkv"},{"op":"split","in":["qkv"],"sizes":[16,16,16],"out":["q","k","v"]},{"op":"recurrence","in":["q","k","v"],"state":"rec","index":{"e":8,"h":2},"inputs":["q[h,e]","k[h,e]","v[h,e]"],"let":["pk[h,e] = where(k[h,e], k[h,e] + 1, (exp(min(0, k[h,e])) - 1) + 1)"],"update":["num[h,e] = 0.9375 * num[h,e] + pk[h,e] * v[h,e]","den[h,e] = 0.9375 * den[h,e] + pk[h,e]"],"readout":"y[h,e] = (where(q[h,e], q[h,e] + 1, (exp(min(0, q[h,e])) - 1) + 1) * num[h,e]) / max(den[h,e], 1e-08)","out":"a"},{"op":"linear","in":["a"],"weight":"blk.{i}.attn_output.weight","bias":"blk.{i}.attn_output.bias","out":"o"},{"op":"add","in":["x","o"],"out":"x"},{"op":"layernorm","in":["x"],"weight":"blk.{i}.ffn_norm.weight","bias":"blk.{i}.ffn_norm.bias","eps":1e-05,"out":"h2"},{"op":"linear","in":["h2"],"weight":"blk.{i}.ffn_up.weight","bias":"blk.{i}.ffn_up.bias","out":"u"},{"op":"gelu","in":["u"],"approx":"tanh","ou